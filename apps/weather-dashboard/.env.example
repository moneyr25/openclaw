# Every key below is OPTIONAL. With no keys at all the dashboard still runs and
# aggregates 6 independent numerical weather models plus MET Norway.

# --- Met Office Weather DataHub, Site Specific (free tier available) ---------
# Sign up: https://datahub.metoffice.gov.uk/ -> Site Specific -> subscribe.
MET_OFFICE_API_KEY=

# --- AccuWeather ------------------------------------------------------------
# Register an app at https://developer.accuweather.com/ and use its API key.
# The free "Limited Trial" plan allows 50 calls a day and serves the 12-hour
# forecast only; the location key is cached, so a refresh costs one call.
ACCUWEATHER_API_KEY=
# One of: 1hour, 12hour, 24hour, 72hour, 120hour. Anything beyond 12hour needs
# a paid plan, and asking for one your key cannot reach returns 401.
ACCUWEATHER_HOURLY_RANGE=12hour

# --- Apple Weather (WeatherKit) ---------------------------------------------
# The forecast behind the Weather app on iPhone. Needs a paid Apple Developer
# account ($99/yr, includes 500k calls a month). In the developer portal:
#   1. Identifiers -> new Services ID (a reverse-domain string) -> enable
#      WeatherKit. That string is APPLE_WEATHERKIT_SERVICE_ID.
#   2. Keys -> new key with WeatherKit enabled. Download the .p8 once.
#      The key's ID is APPLE_WEATHERKIT_KEY_ID.
#   3. Your 10-character Team ID is in Membership details.
APPLE_WEATHERKIT_TEAM_ID=
APPLE_WEATHERKIT_SERVICE_ID=
APPLE_WEATHERKIT_KEY_ID=
# Either paste the .p8 contents here (newlines may be written as \n) ...
APPLE_WEATHERKIT_PRIVATE_KEY=
# ... or point at the file instead. Keep the .p8 out of version control.
APPLE_WEATHERKIT_PRIVATE_KEY_PATH=

# --- Other commercial APIs --------------------------------------------------
# OpenWeatherMap One Call 3.0 (free tier, card required on signup).
OPENWEATHERMAP_API_KEY=
# WeatherAPI.com (free tier, no card).
WEATHERAPI_KEY=

# --- MET Norway -------------------------------------------------------------
# Contact string sent as User-Agent. Their terms require a real contact;
# requests without one are rejected with 403.
# https://api.met.no/doc/TermsOfService
MET_NORWAY_CONTACT=you@example.com

# --- Server -----------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
FORECAST_CACHE_TTL=600
